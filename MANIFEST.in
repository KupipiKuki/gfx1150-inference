include CMakeLists.txt
include LICENSE
include README.md
recursive-include src/kernels *.h *.hip
recursive-include src/python_bindings *.cpp
# The pytest harness must ship with the sdist: without tests/conftest.py the
# installed tree has no `matmul_module` fixture, so the GPU lane errors instead
# of skipping (G0 condition C-7A1-5).
recursive-include tests *.py
# Phase 7A-3: the golden fixtures (vocabularies, golden token vectors,
# quantized blocks and the tiny GGUF) and their generator must ship with the
# sdist, or the golden tests cannot run against an installed package.
recursive-include tests/fixtures *

