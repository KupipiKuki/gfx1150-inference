include CMakeLists.txt
include LICENSE
include README.md
recursive-include src/kernels *.h *.hip
recursive-include src/python_bindings *.cpp
# The pytest harness must ship with the sdist: without tests/conftest.py the
# installed tree has no `matmul_module` fixture, so the GPU lane errors instead
# of skipping (G0 condition C-7A1-5).
recursive-include tests *.py
# Phase 7A-3: the golden fixtures (vocabularies, golden token vectors,
# quantized blocks and the tiny GGUF) and their generator must ship with the
# sdist, or the golden tests cannot run against an installed package.
recursive-include tests/fixtures *
# Phase 7F (BLOCKER-7F-4): the shipped CPU lane imports the benchmark
# aggregation module (tests/test_bench_gate.py -> scripts/bench/aggregate.py)
# and the checked-in synthetic baseline; without scripts/ in the sdist the
# extracted-tree lane is red. Ship the bench tooling (.py evidence harness
# and the baseline .json).
recursive-include scripts/bench *.py *.json

# Phase 7G-C (C2): the runner/CI tests exercise the real scripts, the runner
# spec, the watchdog units and the workflow contract. They must ship with the
# sdist, or the extracted-tree lane cannot collect them (the tests locate
# scripts/ci/ and .github/workflows/ relative to the repository root).
recursive-include scripts/ci *.sh *.env *.service *.timer *.logrotate
include .github/workflows/ci-gpu.yml

# Do not ship interpreter caches (the fixtures directory is copied with a
# wildcard, which would otherwise include __pycache__/*.pyc).
global-exclude *.py[cod]

