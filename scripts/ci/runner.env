# scripts/ci/runner.env — single source of truth for the gfx1150 runner.
#
# Sourced by scripts/ci/*.sh. The environment may override any value (the
# `:-` form) so the doctor and its tests can run against a sandbox.
# Nothing else in the repository may hardcode these values; the contract
# test (tests/test_ci_contract.py, C2f) enforces that for the workflow.

REPO_URL="${REPO_URL:-https://github.com/KupipiKuki/gfx1150-inference}"
REPO_SLUG="${REPO_SLUG:-KupipiKuki/gfx1150-inference}"
# The workflow contract lives in the checkout. The doctor runs from the repo
# during development and from /usr/local/sbin when installed, so the checkout
# path is part of the host spec (L5 warns, rather than fails, if it is absent).
REPO_ROOT="${REPO_ROOT:-/home/kupipi/Documents/git/gfx1150-inference}"

RUNNER_NAME="${RUNNER_NAME:-gfx1150-host}"
RUNNER_DIR="${RUNNER_DIR:-/home/kupipi/actions-runner}"
RUNNER_USER="${RUNNER_USER:-kupipi}"
RUNNER_LABELS="${RUNNER_LABELS:-gfx1150,rocm}"
RUNNER_WORK="${RUNNER_WORK:-_work}"

SERVICE_UNIT="${SERVICE_UNIT:-actions.runner.KupipiKuki-gfx1150-inference.gfx1150-host.service}"
WATCHDOG_TIMER="${WATCHDOG_TIMER:-gfx1150-runner-watchdog.timer}"

PAT_FILE="${PAT_FILE:-/etc/gfx1150-runner/runner.pat}"
PAT_OWNER="${PAT_OWNER:-root}"
PAT_MODE="${PAT_MODE:-600}"

LISTEN_MARKER="${LISTEN_MARKER:-Listening for Jobs}"
DELETED_MARKER="${DELETED_MARKER:-registration has been deleted}"
SKEW_MARKER="${SKEW_MARKER:-not valid until}"

# The host boots at ~03:38 UTC; the nightly GPU lane must clear that window
# with margin (measured 2026-11-14).
BOOT_WINDOW_UTC="${BOOT_WINDOW_UTC:-03:38}"
NIGHTLY_CRON_UTC="${NIGHTLY_CRON_UTC:-05:00}"
CRON_MARGIN_MIN="${CRON_MARGIN_MIN:-30}"

STARTUP_GRACE_SECS="${STARTUP_GRACE_SECS:-180}"
COOLDOWN_SECS="${COOLDOWN_SECS:-1800}"
SKEW_WARN_SECS="${SKEW_WARN_SECS:-5}"
SKEW_FAIL_SECS="${SKEW_FAIL_SECS:-60}"

# Watchdog timing and state (C2b/C2c). The doctor is bounded so a hung curl
# cannot stall the 5-minute timer; the state file lives on tmpfs and resets at
# boot, which is what makes the first alert after a boot fire.
DOCTOR_TIMEOUT_SECS="${DOCTOR_TIMEOUT_SECS:-180}"
REPAIR_VERIFY_SECS="${REPAIR_VERIFY_SECS:-15}"
REPAIR_VERIFY_POLLS="${REPAIR_VERIFY_POLLS:-6}"
STATE_FILE="${STATE_FILE:-/run/gfx1150-runner.state}"
ALERT_UNIT="${ALERT_UNIT:-gfx1150-runner-watchdog-alert.service}"

REQUIRED_GPU_CHECK="${REQUIRED_GPU_CHECK:-GPU correctness (self-hosted gfx1150)}"

# Installed locations (C2d installer). The doctor checks both the new name
# and the name the current deployment uses.
WATCHDOG_INSTALLED="${WATCHDOG_INSTALLED:-/usr/local/sbin/gfx1150-runner-watchdog}"
WATCHDOG_LEGACY_INSTALLED="${WATCHDOG_LEGACY_INSTALLED:-/usr/local/sbin/ensure_runner_registered.sh}"
DOCTOR_INSTALLED="${DOCTOR_INSTALLED:-/usr/local/sbin/gfx1150-runner-doctor}"
# The installer writes the expected watchdog sha256 here; the installed doctor
# uses it for the drift check (the repository copy is not present on the host).
DRIFT_MANIFEST="${DRIFT_MANIFEST:-/etc/gfx1150-runner/watchdog.sha256}"
WATCHDOG_LOG="${WATCHDOG_LOG:-/var/log/ensure-runner.log}"
COOLDOWN_FILE="${COOLDOWN_FILE:-/run/ensure-runner.last-repair}"
