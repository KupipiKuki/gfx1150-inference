# ==============================================================================
# 3. The tokenizer fixtures
# ==============================================================================

# The generator (tests/fixtures/make_fixtures.py) reads the upstream files,
# writes the vocabulary fixtures, builds a vocabulary-only GGUF with llama.cpp's
# own writer, and drives llama.cpp's own tokenizer to produce the goldens.
$ python3 make_fixtures.py tokenizer \
      --llama-cpp /tmp/opencode/llama.cpp \
      --gguf-py /tmp/opencode/llama.cpp/gguf-py \
      --gpt2-vocab /tmp/opencode/upstream/gpt2-vocab.json \
      --gpt2-merges /tmp/opencode/upstream/gpt2-merges.txt \
      --gpt2-revision 607a30d783dfa663caf39e06633721c8d4cfcd7e \
      --spm-gguf /tmp/opencode/upstream/stories260K.gguf \
      --spm-revision "ggml-org/models@main:tinyllamas/stories260K.gguf" \
      --out .
