=== what each case means ===
  spm_absent_add_bos_metadata      add_bos=True   flags=['--no-parse-special']                   plain text; the vocabulary's GGUF has no add_bos_token key, so the reference adds a BOS
  spm_plain_text_no_bos            add_bos=False  flags=['--no-bos', '--no-parse-special']       the same text with --no-bos
  spm_double_space                 add_bos=True   flags=['--no-parse-special']                   two spaces between the words
  spm_multibyte_accent             add_bos=True   flags=['--no-parse-special']                   a two-byte character
  spm_multibyte_greek              add_bos=True   flags=['--no-parse-special']                   a two-byte character outside the Latin range (byte fallback)
  spm_multibyte_emoji              add_bos=True   flags=['--no-parse-special']                   a four-byte character (four byte-fallback tokens)
  spm_punctuation_digits           add_bos=True   flags=['--no-parse-special']                   punctuation and digits
  spm_contraction_were             add_bos=True   flags=['--no-parse-special']                   a contraction
  spm_contraction_dont             add_bos=True   flags=['--no-parse-special']                   a contraction -- KNOWN MISMATCH (7B/7C)
  spm_control_token_literal        add_bos=True   flags=['--no-parse-special']                   a control token as ordinary text
  spm_control_token_parsed         add_bos=True   flags=[]                                       a control token parsed by the reference -- KNOWN MISMATCH (7B)

