----- step 5: Assert the sdist ships the pytest harness (C-7A1-5) -----
set -euo pipefail
SDIST="$(ls -1 dist/*.tar.gz | head -1)"
echo "sdist: ${SDIST}"
tar -tzf "${SDIST}" > sdist-contents.txt
cat sdist-contents.txt
for required in tests/conftest.py tests/test_harness_contract.py; do
  if ! grep -qE "^[^/]+/${required}$" sdist-contents.txt; then
    echo "FAIL: the sdist does not contain ${required}"
    exit 1
  fi
  echo "ok: the sdist contains ${required}"
done
# Every Python file under tests/ must ship: a test that is missing
# from the sdist cannot run against an installed package.
for path in tests/*.py; do
  if ! grep -qE "^[^/]+/${path}$" sdist-contents.txt; then
    echo "FAIL: the sdist does not contain ${path}"
    exit 1
  fi
done
echo "ok: every tests/*.py in the repository is in the sdist"

----- step 6: Install the sdist into a clean venv (CPU-only path) -----
set -euo pipefail
rm -rf .venv-sdist
python -m venv .venv-sdist
# shellcheck disable=SC1091
. .venv-sdist/bin/activate
python -m pip install --upgrade pip
# setuptools is needed in the venv, not just for the install: the
# shipped suite's packaging test (test_v8_b1_pyproject_and_sdist_
# contents) builds an sdist with the interpreter that runs the tests.
python -m pip install pytest "setuptools>=64"
export GFX1150_SKIP_CMAKE=1
python -m pip install dist/*.tar.gz
python -m pip list

----- step 7: Assert the installed module split (CPU imports; GPU modules raise) -----
set -euo pipefail
# shellcheck disable=SC1091
. .venv-sdist/bin/activate
cd "$(mktemp -d)"
python - <<'PY'
import importlib
import pathlib
import sys

CPU_MODULES = ("gguf_parser", "tokenizer", "weight_loader")
GPU_MODULES = ("kv_cache", "layer", "inference")

# The extension must genuinely be absent, or the GPU assertions below
# would be vacuous.
try:
    importlib.import_module("matmul_module")
except ImportError:
    print("ok: 'matmul_module' is not importable (the CPU-only path)")
else:
    print("FAIL: 'matmul_module' is importable; the GPU assertions would be vacuous")
    sys.exit(1)

prefix = pathlib.Path(sys.prefix).resolve()
for name in CPU_MODULES:
    module = importlib.import_module(name)
    location = pathlib.Path(module.__file__).resolve()
    if prefix not in location.parents:
        print(f"FAIL: {name} was imported from {location}, not from the installed venv")
        sys.exit(1)
    print(f"ok: {name} imports cleanly from the installed venv ({location})")

for name in GPU_MODULES:
    try:
        importlib.import_module(name)
    except ImportError as exc:
        message = str(exc)
        if "matmul_module" not in message:
            print(f"FAIL: {name} raised an ImportError that is not actionable:")
            print(f"      {message}")
            sys.exit(1)
        print(f"ok: {name} raises an actionable ImportError")
        print(f"      {message.splitlines()[0]}")
    else:
        print(f"FAIL: {name} imported cleanly; the CPU/GPU module split is broken")
        sys.exit(1)

print("PASS: the installed package exposes the CPU modules and rejects the GPU modules")
PY

