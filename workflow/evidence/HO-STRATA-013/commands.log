=== C12 (rehash after non-aggregate artifacts) ===
cwd: /home/kupipi/Documents/git/gfx1150-inference
python3 - <<'PY' > workflow/evidence/HO-STRATA-013/hashes.txt
import hashlib
from pathlib import Path

root = Path(".")
bundle = Path("workflow/evidence/HO-STRATA-013")
files = sorted(
    p for p in bundle.rglob("*")
    if p.is_file() and p.name != "hashes.txt"
)
# The immutable tool is also part of this bundle's evidence.
files.append(Path("workflow/tools/check_bundle.py"))
print("# SHA-256 hashes — HO-STRATA-013 evidence bundle")
print("# Generated after the RW-3 evidence refresh.")
print("# hashes.txt excludes itself. Paths are repo-root relative.")
for p in files:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for ch in iter(lambda: f.read(65536), b""):
            h.update(ch)
    rel = p.resolve().relative_to(root.resolve()).as_posix()
    print(f"{h.hexdigest()}  {rel}")
PY
exit: 0

