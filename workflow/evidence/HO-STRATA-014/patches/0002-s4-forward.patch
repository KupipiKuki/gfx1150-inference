+// include/strata/deepseek/engine.hpp - DeepSeek-MoE-16B dedicated parity engine entry point.
+// Dispatched from src/program/generate.cpp only under --parity-run; normal runs refuse.
+#pragma once
+
+namespace strata::deepseek {
+
+/// Run the DeepSeek parity engine.  Returns the process exit code.
+int run(int argc, char** argv);
