--- /dev/null
+++ b/src/deepseek/ds_engine.cu
@@ -0,0 +1,474 @@
+// src/deepseek/ds_engine.cu - DeepSeek-MoE-16B parity engine (S4a: block 0 only).
+// Built from Strata kernels; no captured graphs, no expert cache, no MoE code.
+#include "strata/artifact/gguf_reader.hpp"
+#include "strata/core/family_layout.hpp"
+#include "strata/deepseek/engine.hpp"
+#include "strata/kernels/bf16_bits.hpp"
+#include "strata/kernels/elementwise.hpp"
+#include "strata/kernels/f16_bits.hpp"
+#include "strata/kernels/iq_kernels.hpp"
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/quantize_act.hpp"
+#include "strata/kernels/rope.hpp"
+#include "strata/kernels/rope_scaling.hpp"
+
+#include "ds_f32_matvec.cuh"
+#include "ds_kernels.cuh"
+
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+
+#define CK(x)                                                                                              \
+    do {                                                                                                   \
+        cudaError_t e_ = (x);                                                                              \
+        if (e_ != cudaSuccess) {                                                                           \
+            std::fprintf(stderr, "strata-deepseek: %s failed: %s (%s:%d)\n", #x, cudaGetErrorString(e_),   \
+                         __FILE__, __LINE__);                                                              \
+            std::exit(1);                                                                                  \
+        }                                                                                                  \
+    } while (0)
+
+namespace K = strata::kernels;
+
+// ------------------------------------------------------------------------------------------------ small kernels
+
+namespace D = strata::deepseek;
+
+// ------------------------------------------------------------------------------------------------ weight helper
+
+struct Weight {
+    int ggml_type = 0;
+    int n_in = 0;   // contiguous dimension
+    int n_out = 0;  // number of rows
+    void* d = nullptr;
+    strata::deepseek::F32Weight f32;  // parity-only f32 copy (Q8_1 activation bypass)
+};
+
+static float* upload_f32(const strata::GgufModel& gm, const std::string& name) {
+    size_t shard = 0;
+    const strata::TensorInfo* tp = gm.find(name, &shard);
+    if (!tp) {
+        std::fprintf(stderr, "strata-deepseek: missing %s\n", name.c_str());
+        std::exit(1);
+    }
+    const strata::TensorInfo& t = *tp;
+    const uint64_t n = t.elements();
+    std::vector<float> h(n);
+    const uint8_t* src = gm.shard(shard).tensor_data(t);
+    if (t.type == 0) {
+        std::memcpy(h.data(), src, n * 4);
+    } else if (t.type == 1) {
+        for (uint64_t i = 0; i < n; ++i) h[i] = K::f32_from_f16(((const uint16_t*) src)[i]);
+    } else if (t.type == 30) {
+        for (uint64_t i = 0; i < n; ++i) h[i] = K::f32_from_bf16(((const uint16_t*) src)[i]);
+    } else if (t.type == 8 && n % 32 == 0) {
+        K::dequant_q8_0(src, h.data(), (int64_t) n, nullptr);
+    } else {
+        std::fprintf(stderr, "strata-deepseek: %s is %s, expected F32/F16/BF16/Q8_0\n", t.name.c_str(),
+                     t.type_name());
+        std::exit(1);
+    }
+    float* d = nullptr;
+    CK(cudaMalloc(&d, n * 4));
+    CK(cudaMemcpy(d, h.data(), n * 4, cudaMemcpyHostToDevice));
+    return d;
+}
+
+static Weight upload_weight(const strata::GgufModel& gm, const std::string& name) {
+    size_t shard = 0;
+    const strata::TensorInfo* t = gm.find(name, &shard);
+    if (!t) {
+        std::fprintf(stderr, "strata-deepseek: missing %s\n", name.c_str());
+        std::exit(1);
+    }
+    Weight w;
+    w.ggml_type = (int) t->type;
+    w.n_in = (int) t->shape[0];
+    w.n_out = (int) t->shape[1];
+    if (!K::native_mmvq_supported(w.ggml_type)) {
+        std::fprintf(stderr, "strata-deepseek: %s is %s, native MMVQ does not take it\n", name.c_str(),
+                     t->type_name());
+        std::exit(1);
+    }
+    const uint64_t nb = strata::tensor_payload_bytes(*t);
+    void* d = nullptr;
+    CK(cudaMalloc(&d, nb));
+    CK(cudaMemcpy(d, gm.shard(shard).tensor_data(*t), nb, cudaMemcpyHostToDevice));
+    w.d = d;
+    // For the parity path we keep an f32 copy so matvecs can run with f32 activations
+    // and bypass the Q8_1 quantization error.
+    w.f32 = strata::deepseek::upload_weight_f32(gm, name);
+    return w;
+}
+
+static void matvec(const Weight& w, const float* x_f32, float* y, void* stream) {
+    // Parity build: use the local f32 matvec to match the CPU oracle's f32 activations.
+    strata::deepseek::f32_matvec(w.f32, x_f32, y, stream);
+}
+
+// ------------------------------------------------------------------------------------------------ engine state
+
+struct Layer0 {
+    float* attn_norm = nullptr;
+    Weight wq, wk, wv, wo;
+    float* ffn_norm = nullptr;
+    Weight ffn_gate, ffn_up, ffn_down;
+};
+
+struct Model {
+    strata::core::ModelGeometry g;
+    float* token_embd = nullptr;  // [n_vocab, n_embd] f32 (dequantized on device)
+    float* output_norm = nullptr;
+    Weight output;  // may be unused if tied
+    bool output_tied = false;
+    Layer0 layer0;
+};
+
+struct Buffers {
+    float* residual = nullptr;
+    float* norm_out = nullptr;
+    float* q = nullptr;
+    float* k = nullptr;
+    float* v = nullptr;
+    float* attn_out = nullptr;
+    float* ffn_gate = nullptr;
+    float* ffn_up = nullptr;
+    float* kcache = nullptr;
+    float* vcache = nullptr;
+    void* q8_1_scratch = nullptr;
+    int* pos_dev = nullptr;
+    float* dump = nullptr;
+};
+
+// ------------------------------------------------------------------------------------------------ load
+
+static bool load_model(const std::string& path, Model& m, std::string& err) {
+    strata::GgufModel gm = strata::GgufModel::open(path);
+    int64_t top_k = 0;
+    if (!strata::core::geometry_from_gguf(gm.meta(), m.g, top_k, err)) return false;
+    if (m.g.family != strata::ModelFamily::DeepseekMoe) {
+        err = "strata-deepseek runs DeepSeek-MoE-16B (deepseek) files only";
+        return false;
+    }
+    if (m.g.n_embd != 2048 || m.g.n_head != 16 || m.g.n_head_kv != 16 || m.g.n_ff_dense != 10944) {
+        err = "strata-deepseek S4a: this driver is built for DeepSeek-MoE-16B base";
+        return false;
+    }
+
+    // token embedding: dequantize the whole table on the device for simple gather
+    {
+        size_t shard = 0;
+        const strata::TensorInfo* t = gm.find("token_embd.weight", &shard);
+        if (!t) { err = "missing token_embd.weight"; return false; }
+        if (!K::embed_type_supported((int) t->type)) {
+            err = std::string("token_embd.weight is ") + t->type_name() + ", which the embedding kernels do not take";
+            return false;
+        }
+        const uint64_t n = t->elements();
+        const uint64_t nb = strata::tensor_payload_bytes(*t);
+        void* raw = nullptr;
+        CK(cudaMalloc(&raw, nb));
+        CK(cudaMemcpy(raw, gm.shard(shard).tensor_data(*t), nb, cudaMemcpyHostToDevice));
+        CK(cudaMalloc(&m.token_embd, n * 4));
+        K::iq_dequant_f32((int) t->type, raw, (int64_t) n, m.token_embd, nullptr);
+        CK(cudaFree(raw));
+    }
+
+    m.output_norm = upload_f32(gm, "output_norm.weight");
+
+    {
+        size_t shard = 0;
+        const strata::TensorInfo* t = gm.find("output.weight", &shard);
+        if (t) m.output = upload_weight(gm, "output.weight");
+        else m.output_tied = true;
+    }
+
+    Layer0& l = m.layer0;
+    l.attn_norm = upload_f32(gm, "blk.0.attn_norm.weight");
+    l.wq = upload_weight(gm, "blk.0.attn_q.weight");
+    l.wk = upload_weight(gm, "blk.0.attn_k.weight");
+    l.wv = upload_weight(gm, "blk.0.attn_v.weight");
+    l.wo = upload_weight(gm, "blk.0.attn_output.weight");
+    l.ffn_norm = upload_f32(gm, "blk.0.ffn_norm.weight");
+    l.ffn_gate = upload_weight(gm, "blk.0.ffn_gate.weight");
+    l.ffn_up = upload_weight(gm, "blk.0.ffn_up.weight");
+    l.ffn_down = upload_weight(gm, "blk.0.ffn_down.weight");
+
+    return true;
+}
+
+static void alloc_buffers(const Model& m, Buffers& b, int max_context) {
+    const int64_t N = m.g.n_embd;
+    const int64_t FF = m.g.n_ff_dense;
+    CK(cudaMalloc(&b.residual, N * 4));
+    CK(cudaMalloc(&b.norm_out, N * 4));
+    CK(cudaMalloc(&b.q, N * 4));
+    CK(cudaMalloc(&b.k, N * 4));
+    CK(cudaMalloc(&b.v, N * 4));
+    CK(cudaMalloc(&b.attn_out, N * 4));
+    CK(cudaMalloc(&b.ffn_gate, FF * 4));
+    CK(cudaMalloc(&b.ffn_up, FF * 4));
+    CK(cudaMalloc(&b.kcache, (size_t) max_context * N * 4));
+    CK(cudaMalloc(&b.vcache, (size_t) max_context * N * 4));
+    CK(cudaMalloc(&b.q8_1_scratch, K::native_q8_1_bytes((int) std::max(N, FF))));
+    CK(cudaMalloc(&b.pos_dev, (size_t) m.g.n_head * sizeof(int)));
+    // dump: 2 slots (input + block 0) per position, contiguous [position][slot][n_embd]
+    CK(cudaMalloc(&b.dump, (size_t) max_context * 2 * N * 4));
+}
+
+// ------------------------------------------------------------------------------------------------ forward
+
+#ifdef STRATA_DEEPSEEK_DIAG
+static void dump_f32(const char* path, const float* d, size_t n, cudaStream_t stream) {
+    std::vector<float> h(n);
+    CK(cudaMemcpyAsync(h.data(), d, n * 4, cudaMemcpyDeviceToHost, stream));
+    CK(cudaStreamSynchronize(stream));
+    std::FILE* f = std::fopen(path, "wb");
+    if (!f) { std::fprintf(stderr, "dump_f32: cannot write %s\n", path); std::exit(1); }
+    std::fwrite(h.data(), 4, n, f);
+    std::fclose(f);
+}
+#define DIAG_DUMP(path, ptr, n) dump_f32(path, ptr, n, (cudaStream_t)stream)
+#else
+#define DIAG_DUMP(path, ptr, n) do {} while(0)
+#endif
+
+static void run_block0(const Model& m, Buffers& b, int pos, int n_kv, const float* cos_tab, const float* sin_tab,
+                       void* stream) {
+    const int64_t N = m.g.n_embd;
+    const int64_t FF = m.g.n_ff_dense;
+    const int n_head = (int) m.g.n_head;
+    const int head_dim = (int) (N / m.g.n_head);
+    const float attn_scale = 1.0f / std::sqrt((float) head_dim);
+    const Layer0& l = m.layer0;
+
+    // pre-norm RMSNorm: residual -> norm_out
+    CK(cudaMemcpyAsync(b.norm_out, b.residual, N * 4, cudaMemcpyDeviceToDevice, (cudaStream_t) stream));
+    K::rms_norm_weighted(b.norm_out, l.attn_norm, 1, N, (float) m.g.rms_eps, stream);
+    DIAG_DUMP((std::string("/tmp/opencode/diag_attnnorm_p") + std::to_string(pos) + ".bin").c_str(), b.norm_out, (size_t) N);
+
+    // Q/K/V projections (norm_out -> q/k/v)
+    matvec(l.wq, b.norm_out, b.q, stream);
+    matvec(l.wk, b.norm_out, b.k, stream);
+    matvec(l.wv, b.norm_out, b.v, stream);
+    DIAG_DUMP((std::string("/tmp/opencode/diag_q_p") + std::to_string(pos) + ".bin").c_str(), b.q, (size_t) N);
+    DIAG_DUMP((std::string("/tmp/opencode/diag_k_p") + std::to_string(pos) + ".bin").c_str(), b.k, (size_t) N);
+    DIAG_DUMP((std::string("/tmp/opencode/diag_v_p") + std::to_string(pos) + ".bin").c_str(), b.v, (size_t) N);
+
+    // RoPE on Q and K (full head_dim = n_rot for DeepSeek); pos is per-row.
+    // DeepSeek uses llama.cpp's NORM-style RoPE (consecutive pairs), not NEOX.
+    {
+        std::vector<int> pos_h(n_head, pos);
+        CK(cudaMemcpyAsync(b.pos_dev, pos_h.data(), (size_t) n_head * sizeof(int), cudaMemcpyHostToDevice,
+                           (cudaStream_t) stream));
+    }
+    D::k_rope_norm<<<1, n_head, 0, (cudaStream_t) stream>>>(b.q, b.q, n_head, head_dim, head_dim, cos_tab, sin_tab,
+                                                             b.pos_dev);
+    D::k_rope_norm<<<1, n_head, 0, (cudaStream_t) stream>>>(b.k, b.k, n_head, head_dim, head_dim, cos_tab, sin_tab,
+                                                             b.pos_dev);
+
+    // append K/V to cache
+    CK(cudaMemcpyAsync(b.kcache + (size_t) pos * N, b.k, N * 4, cudaMemcpyDeviceToDevice, (cudaStream_t) stream));
+    CK(cudaMemcpyAsync(b.vcache + (size_t) pos * N, b.v, N * 4, cudaMemcpyDeviceToDevice, (cudaStream_t) stream));
+
+    // attention: q/k/vcache -> attn_out
+    D::k_mha_decode<<<1, n_head, 0, (cudaStream_t) stream>>>(
+        b.q, b.kcache, b.vcache, b.attn_out, n_head, head_dim, n_kv, attn_scale);
+
+    // output projection
+    matvec(l.wo, b.attn_out, b.norm_out, stream);
+
+    // residual add: residual += norm_out (which holds attention output)
+    {
+        const int threads = 256;
+        const int blocks = (int) ((N + threads - 1) / threads);
+        D::k_add<<<blocks, threads, 0, (cudaStream_t) stream>>>(b.norm_out, b.residual, N);
+    }
+    DIAG_DUMP((std::string("/tmp/opencode/diag_postattn_p") + std::to_string(pos) + ".bin").c_str(), b.residual, (size_t) N);
+
+    // pre-FFN RMSNorm: residual -> norm_out
+    CK(cudaMemcpyAsync(b.norm_out, b.residual, N * 4, cudaMemcpyDeviceToDevice, (cudaStream_t) stream));
+    K::rms_norm_weighted(b.norm_out, l.ffn_norm, 1, N, (float) m.g.rms_eps, stream);
+
+    // dense SwiGLU FFN
+    matvec(l.ffn_gate, b.norm_out, b.ffn_gate, stream);
+    matvec(l.ffn_up, b.norm_out, b.ffn_up, stream);
+    {
+        const int threads = 256;
+        const int blocks = (int) ((FF + threads - 1) / threads);
+        D::k_swiglu_mul<<<blocks, threads, 0, (cudaStream_t) stream>>>(b.ffn_gate, b.ffn_up, FF);
+    }
+    matvec(l.ffn_down, b.ffn_up, b.norm_out, stream);
+
+    // residual add: residual += norm_out (which holds FFN output)
+    {
+        const int threads = 256;
+        const int blocks = (int) ((N + threads - 1) / threads);
+        D::k_add<<<blocks, threads, 0, (cudaStream_t) stream>>>(b.norm_out, b.residual, N);
+    }
+    DIAG_DUMP((std::string("/tmp/opencode/diag_block0_p") + std::to_string(pos) + ".bin").c_str(), b.residual, (size_t) N);
+}
+
+// ------------------------------------------------------------------------------------------------ run
+
+struct Options {
+    std::string native;
+    std::string dump_layers;
+    std::vector<int64_t> tokens;
+    int64_t max_new = 1;
+    int64_t max_context = 1024;
+};
+
+static bool parse_i64_list(const char* s, std::vector<int64_t>& out, std::string& err) {
+    out.clear();
+    std::string cur;
+    auto flush = [&]() -> bool {
+        if (cur.empty()) return true;
+        char* end = nullptr;
+        long long v = std::strtoll(cur.c_str(), &end, 10);
+        if (*end != '\0') { err = "expected integer list"; return false; }
+        out.push_back(v);
+        cur.clear();
+        return true;
+    };
+    for (; *s; ++s) {
+        if (*s == ',') { if (!flush()) return false; }
+        else if ((*s >= '0' && *s <= '9') || *s == '-' || *s == '+') cur.push_back(*s);
+        else { err = "unexpected character in integer list"; return false; }
+    }
+    return flush();
+}
+
+}  // namespace
+
+namespace strata::deepseek {
+
+int run(int argc, char** argv) {
+    Options o;
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        auto next = [&](const char* what) -> const char* {
+            if (i + 1 >= argc) {
+                std::fprintf(stderr, "strata-deepseek: %s needs a value\n", what);
+                std::exit(2);
+            }
+            return argv[++i];
+        };
+        if (a == "--native") o.native = next("--native");
+        else if (a == "--model") o.native = next("--model");
+        else if (a == "--tokens") {
+            std::string e;
+            if (!parse_i64_list(next("--tokens"), o.tokens, e)) {
+                std::fprintf(stderr, "strata-deepseek: %s\n", e.c_str());
+                return 2;
+            }
+        } else if (a == "--max-new") o.max_new = std::atoll(next("--max-new"));
+        else if (a == "--max-context") o.max_context = std::atoll(next("--max-context"));
+        else if (a == "--dump-layers") o.dump_layers = next("--dump-layers");
+        // ignore other flags silently (temperature, etc.)
+    }
+
+    if (o.native.empty()) {
+        std::fprintf(stderr, "strata-deepseek: --native / --model is required\n");
+        return 2;
+    }
+    if (o.dump_layers.empty()) {
+        std::fprintf(stderr, "strata-deepseek: --dump-layers is required\n");
+        return 2;
+    }
+    if (o.tokens.empty()) {
+        std::fprintf(stderr, "strata-deepseek: --tokens is required\n");
+        return 2;
+    }
+
+    // The caller (generate.cpp) has already verified the family and printed the parity warning.
+    std::fprintf(stderr,
+                 "strata generate: parity run: architecture 'deepseek' is not supported; this path exists for "
+                 "HO-STRATA-014/015 parity only\n");
+
+    // Set rope scaling: DeepSeek base 1e4, no scaling.
+    K::RopeScaling rs;
+    rs.type = K::RopeScalingType::None;
+    rs.freq_base = 10000.0;
+    K::rope_scaling_set(rs);
+
+    Model m;
+    std::string err;
+    if (!load_model(o.native, m, err)) {
+        std::fprintf(stderr, "strata-deepseek: %s\n", err.c_str());
+        return 1;
+    }
+
+    const int max_context = (int) std::min<int64_t>(o.max_context, 4096);
+    Buffers b;
+    alloc_buffers(m, b, max_context);
+
+    // RoPE table for full head_dim (128) at DeepSeek base.
+    const int head_dim = (int) (m.g.n_embd / m.g.n_head);
+    std::vector<float> cos_tab((size_t) max_context * (head_dim / 2));
+    std::vector<float> sin_tab((size_t) max_context * (head_dim / 2));
+    K::build_rope_table(head_dim, K::rope_scaling(), max_context, cos_tab.data(), sin_tab.data());
+    float* d_cos = nullptr, * d_sin = nullptr;
+    CK(cudaMalloc(&d_cos, cos_tab.size() * 4));
+    CK(cudaMalloc(&d_sin, sin_tab.size() * 4));
+    CK(cudaMemcpy(d_cos, cos_tab.data(), cos_tab.size() * 4, cudaMemcpyHostToDevice));
+    CK(cudaMemcpy(d_sin, sin_tab.data(), sin_tab.size() * 4, cudaMemcpyHostToDevice));
+
+    cudaStream_t stream;
+    CK(cudaStreamCreate(&stream));
+
+    const int n_prompt = (int) o.tokens.size();
+    const int n_total = n_prompt + (int) o.max_new;
+    const int64_t N = m.g.n_embd;
+
+    for (int pos = 0; pos < n_total; ++pos) {
+        if (pos < n_prompt) {
+            const int tok_id = (int) o.tokens[pos];
+            CK(cudaMemcpyAsync(b.residual, m.token_embd + (size_t) tok_id * N, N * 4,
+                               cudaMemcpyDeviceToDevice, stream));
+        }
+
+        // dump slot 0 = input residual
+        CK(cudaMemcpyAsync(b.dump + (size_t) pos * 2 * N, b.residual, N * 4, cudaMemcpyDeviceToDevice, stream));
+
+        // run block 0
+        run_block0(m, b, pos, pos + 1, d_cos, d_sin, stream);
+
+        // dump slot 1 = after block 0
+        CK(cudaMemcpyAsync(b.dump + ((size_t) pos * 2 + 1) * N, b.residual, N * 4, cudaMemcpyDeviceToDevice, stream));
+    }
+
+    CK(cudaStreamSynchronize(stream));
+
+    // write dump file
+    {
+        std::FILE* f = std::fopen(o.dump_layers.c_str(), "wb");
+        if (!f) {
+            std::fprintf(stderr, "strata-deepseek: cannot write %s\n", o.dump_layers.c_str());
+            return 1;
+        }
+        std::vector<float> h((size_t) n_total * 2 * N);
+        CK(cudaMemcpy(h.data(), b.dump, h.size() * 4, cudaMemcpyDeviceToHost));
+        if (std::fwrite(h.data(), 4, h.size(), f) != h.size()) {
+            std::fprintf(stderr, "strata-deepseek: short write on %s\n", o.dump_layers.c_str());
+            std::fclose(f);
+            return 1;
+        }
+        std::fclose(f);
+        std::printf("layers dumped: %s (1 layer + the input x 1 streams x %lld)\n", o.dump_layers.c_str(),
+                    (long long) N);
+    }
+
+    CK(cudaStreamDestroy(stream));
+    return 0;
+}
+
+}  // namespace strata::deepseek
