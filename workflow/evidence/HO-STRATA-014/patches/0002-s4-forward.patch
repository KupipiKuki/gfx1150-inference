+++ b/src/deepseek/ds_f32_matvec.cu
@@ -0,0 +1,129 @@
+// src/deepseek/ds_f32_matvec.cu — local f32 matvec for the DeepSeek parity path.
+// Dequantizes the supported GGUF types to f32 on the host, uploads the row-major
+// matrix, and provides a simple f32 GEMV kernel.  This lives only in
+// strata_deepseek; no shared kernels are edited.
+
+#include "ds_f32_matvec.cuh"
+
+#include "strata/artifact/dequant.hpp"
+#include "strata/artifact/gguf_reader.hpp"
+#include "strata/core/weights.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace strata::deepseek {
+
+namespace {
+
+#define CK(x)                                                                                              \
+    do {                                                                                                   \
+        cudaError_t e_ = (x);                                                                              \
+        if (e_ != cudaSuccess) {                                                                           \
+            std::fprintf(stderr, "strata-deepseek: %s failed: %s (%s:%d)\n", #x, cudaGetErrorString(e_),   \
+                         __FILE__, __LINE__);                                                              \
+            std::exit(1);                                                                                  \
+        }                                                                                                  \
+    } while (0)
+
+// Quantized type ids used by the DeepSeek-MoE-16B Q4_K_M pack for block 0.
+enum GgmlType : int {
+    Q8_0 = 8,
+    Q4_K = 12,
+    Q6_K = 14,
+};
+
+__global__ void k_f32_matvec(const float* __restrict__ W, const float* __restrict__ x, float* __restrict__ y,
+                             int n_in, int n_out) {
+    const int o = blockIdx.x * blockDim.x + threadIdx.x;
+    if (o >= n_out) return;
+    const float* row = W + static_cast<size_t>(o) * n_in;
+    float sum = 0.0f;
+    for (int i = 0; i < n_in; ++i) {
+        sum += row[i] * x[i];
+    }
+    y[o] = sum;
+}
+
+} // namespace
+
+F32Weight upload_weight_f32(const strata::GgufModel& gm, const std::string& name) {
+    size_t shard = 0;
+    const strata::TensorInfo* t = gm.find(name, &shard);
+    if (!t) {
+        std::fprintf(stderr, "strata-deepseek: upload_weight_f32: missing %s\n", name.c_str());
+        std::exit(1);
+    }
+    if (t->shape.size() != 2) {
+        std::fprintf(stderr, "strata-deepseek: upload_weight_f32: %s is not 2-D\n", name.c_str());
+        std::exit(1);
+    }
+    int block_elems = 0, block_bytes = 0;
+    if (!strata::block_geometry(t->type, block_elems, block_bytes)) {
+        std::fprintf(stderr, "strata-deepseek: upload_weight_f32: %s has unknown type %d\n", name.c_str(), (int)t->type);
+        std::exit(1);
+    }
+    const int64_t n_in = static_cast<int64_t>(t->shape[0]);
+    const int64_t n_out = static_cast<int64_t>(t->shape[1]);
+    if (n_in % block_elems != 0) {
+        std::fprintf(stderr, "strata-deepseek: upload_weight_f32: %s n_in %% block_elems != 0\n", name.c_str());
+        std::exit(1);
+    }
+    const int64_t row_bytes = (n_in / block_elems) * block_bytes;
+    const int64_t total_bytes = strata::tensor_payload_bytes(*t);
+    if (total_bytes != row_bytes * n_out) {
+        std::fprintf(stderr, "strata-deepseek: upload_weight_f32: %s payload mismatch (%ld vs %ld)\n", name.c_str(),
+                     (long)total_bytes, (long)(row_bytes * n_out));
+        std::exit(1);
+    }
+
+    const uint8_t* src = static_cast<const uint8_t*>(gm.shard(shard).tensor_data(*t));
+    std::vector<float> host(static_cast<size_t>(n_in * n_out));
+
+    for (int64_t o = 0; o < n_out; ++o) {
+        const uint8_t* row_src = src + o * row_bytes;
+        float* row_dst = host.data() + o * n_in;
+        switch ((int)t->type) {
+        case Q8_0:
+            for (int64_t b = 0; b < n_in / 32; ++b) {
+                strata::dequantize_q8_0(row_src + b * 34, row_dst + b * 32);
+            }
+            break;
+        case Q4_K:
+            for (int64_t b = 0; b < n_in / 256; ++b) {
+                strata::dequantize_q4_K(row_src + b * 144, row_dst + b * 256);
+            }
+            break;
+        case Q6_K:
+            for (int64_t b = 0; b < n_in / 256; ++b) {
+                strata::dequantize_q6_K(row_src + b * 210, row_dst + b * 256);
+            }
+            break;
+        default:
+            std::fprintf(stderr, "strata-deepseek: upload_weight_f32: %s type %d not supported for f32 path\n",
+                         name.c_str(), (int)t->type);
+            std::exit(1);
+        }
+    }
+
+    F32Weight w;
+    w.n_in = static_cast<int>(n_in);
+    w.n_out = static_cast<int>(n_out);
+    CK(cudaMalloc(&w.d, host.size() * sizeof(float)));
+    CK(cudaMemcpy(w.d, host.data(), host.size() * sizeof(float), cudaMemcpyHostToDevice));
+    return w;
+}
+
+void f32_matvec(const F32Weight& w, const float* x, float* y, void* stream) {
+    if (w.n_out <= 0 || w.n_in <= 0) return;
+    const int threads = 256;
+    const int blocks = (w.n_out + threads - 1) / threads;
+    k_f32_matvec<<<blocks, threads, 0, static_cast<cudaStream_t>(stream)>>>(w.d, x, y, w.n_in, w.n_out);
+    CK(cudaGetLastError());
+}
+
+} // namespace strata::deepseek
