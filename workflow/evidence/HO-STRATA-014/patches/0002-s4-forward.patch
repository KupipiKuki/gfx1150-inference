+// src/deepseek/ds_kernels.cuh - small device kernels for the DeepSeek parity engine (S4a).
+#pragma once
+
+#include <cuda_runtime.h>
+#include <cstdint>
+
+namespace strata::deepseek {
+
+// y[i] = silu(x[i]) * y[i]   (in-place on y)
+__global__ void k_swiglu_mul(const float* x, float* y, int64_t n);
+
+// y[i] = x[i] + y[i]   (in-place on y)
+__global__ void k_add(const float* x, float* y, int64_t n);
+
+// MHA decode: one query position, n_kv cached positions, causal already satisfied.
+__global__ void k_mha_decode(const float* q, const float* kcache, const float* vcache, float* out,
+                             int n_head, int head_dim, int n_kv, float scale);
+
+// NORM-style RoPE (llama.cpp LLAMA_ROPE_TYPE_NORM): rotate consecutive pairs (2i, 2i+1).
+// cos_tab/sin_tab are [max_pos][n_rot/2]; pos is one integer per head.
+__global__ void k_rope_norm(const float* x, float* out, int n_head, int head_dim, int n_rot,
+                            const float* cos_tab, const float* sin_tab, const int* pos);
+
+}  // namespace strata::deepseek
