--- /dev/null
+++ b/src/deepseek/ds_kernels.cu
@@ -0,0 +1,81 @@
+// src/deepseek/ds_kernels.cu - small device kernels for the DeepSeek parity engine (S4a).
+#include "ds_kernels.cuh"
+
+namespace strata::deepseek {
+
+__global__ void k_swiglu_mul(const float* x, float* y, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const float v = x[i];
+    y[i] = (v / (1.0f + expf(-v))) * y[i];
+}
+
+__global__ void k_add(const float* x, float* y, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    y[i] = x[i] + y[i];
+}
+
+__global__ void k_mha_decode(const float* q, const float* kcache, const float* vcache, float* out,
+                             int n_head, int head_dim, int n_kv, float scale) {
+    const int h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (h >= n_head) return;
+
+    const float* qh = q + (size_t) h * head_dim;
+    float scores[256];
+
+    float max_s = -INFINITY;
+    for (int p = 0; p < n_kv; ++p) {
+        const float* kh = kcache + ((size_t) p * n_head + h) * head_dim;
+        float s = 0.0f;
+        for (int d = 0; d < head_dim; ++d) s = fmaf(qh[d], kh[d], s);
+        s *= scale;
+        scores[p] = s;
+        max_s = fmaxf(max_s, s);
+    }
+
+    float sum = 0.0f;
+    for (int p = 0; p < n_kv; ++p) {
+        scores[p] = expf(scores[p] - max_s);
+        sum += scores[p];
+    }
+    const float inv_sum = 1.0f / sum;
+    for (int p = 0; p < n_kv; ++p) scores[p] *= inv_sum;
+
+    float* oh = out + (size_t) h * head_dim;
+    for (int d = 0; d < head_dim; ++d) {
+        float acc = 0.0f;
+        for (int p = 0; p < n_kv; ++p) {
+            const float* vh = vcache + ((size_t) p * n_head + h) * head_dim;
+            acc = fmaf(scores[p], vh[d], acc);
+        }
+        oh[d] = acc;
+    }
+}
+
+__global__ void k_rope_norm(const float* __restrict__ x, float* __restrict__ out, int n_head, int head_dim,
+                            int n_rot, const float* __restrict__ cos_tab, const float* __restrict__ sin_tab,
+                            const int* __restrict__ pos) {
+    const int h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (h >= n_head) return;
+
+    const float* xh = x + (size_t) h * head_dim;
+    float* oh = out + (size_t) h * head_dim;
+    const int half = n_rot / 2;
+    const int p = pos[h];
+    const size_t toff = (size_t) p * half;
+
+    for (int i = 0; i < half; ++i) {
+        const float a = xh[2 * i + 0];
+        const float b = xh[2 * i + 1];
+        const float c = cos_tab[toff + i];
+        const float s = sin_tab[toff + i];
+        oh[2 * i + 0] = a * c - b * s;
+        oh[2 * i + 1] = a * s + b * c;
+    }
+    for (int d = n_rot; d < head_dim; ++d) {
+        oh[d] = xh[d];
+    }
+}
+
+}  // namespace strata::deepseek
