+static void softmax_host(const float* logits, float* probs, int n) {
+    float max_l = logits[0];
+    for (int i = 1; i < n; ++i) if (logits[i] > max_l) max_l = logits[i];
+    double sum = 0.0;
+    for (int i = 0; i < n; ++i) {
+        probs[i] = std::exp(logits[i] - max_l);
+        sum += probs[i];
+    }
+    for (int i = 0; i < n; ++i) probs[i] = (float)(probs[i] / sum);
+}
