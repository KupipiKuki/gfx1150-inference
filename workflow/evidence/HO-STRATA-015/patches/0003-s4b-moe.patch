+static void top6_host(const float* probs, int* idx, float* w, int n) {
+    std::vector<int> order(n);
+    for (int i = 0; i < n; ++i) order[i] = i;
+    std::partial_sort(order.begin(), order.begin() + 6, order.end(),
+                      [&](int a, int b) { return probs[a] > probs[b]; });
+    for (int i = 0; i < 6; ++i) {
+        idx[i] = order[i];
+        w[i] = probs[order[i]];
+    }
+}
