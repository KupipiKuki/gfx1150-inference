From 33f3402cf7b2ecfbc2b66248912bf71e8c771ddb Mon Sep 17 00:00:00 2001
From: KupipiKuki <masterkookus@gmail.com>
Date: Wed, 25 Nov 2026 19:46:39 -0500
Subject: [PATCH 5/6] HO-STRATA-015: report device memory usage after
 allocation

Print used/total device memory via cudaMemGetInfo after model load and
buffer allocation, satisfying AC-8 peak-allocation recording.  No functional
change to the forward pass.
---
 src/deepseek/ds_engine.cu | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/deepseek/ds_engine.cu b/src/deepseek/ds_engine.cu
index 763d8e53c..45708d2f9 100644
--- a/src/deepseek/ds_engine.cu
+++ b/src/deepseek/ds_engine.cu
@@ -33,6 +33,20 @@
 
 namespace {
 
+static void print_device_memory(const char* tag) {
+    size_t free_bytes = 0, total_bytes = 0;
+    cudaError_t e = cudaMemGetInfo(&free_bytes, &total_bytes);
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "strata-deepseek: cudaMemGetInfo failed: %s\n", cudaGetErrorString(e));
+        return;
+    }
+    const double gib = 1024.0 * 1024.0 * 1024.0;
+    const size_t used = total_bytes - free_bytes;
+    std::fprintf(stderr,
+                 "strata-deepseek: device memory %s: used=%zu bytes (%.3f GiB), total=%zu bytes (%.3f GiB)\n",
+                 tag, used, used / gib, total_bytes, total_bytes / gib);
+}
+
 #define CK(x)                                                                                              \
     do {                                                                                                   \
         cudaError_t e_ = (x);                                                                              \
@@ -665,6 +679,7 @@ int run(int argc, char** argv) {
     const int max_context = (int) std::min<int64_t>(o.max_context, 4096);
     Buffers b;
     alloc_buffers(m, b, max_context);
+    print_device_memory("after model load + buffer alloc");
 
     const int head_dim = (int) (m.g.n_embd / m.g.n_head);
     std::vector<float> cos_tab((size_t) max_context * (head_dim / 2));
