+/// Read-only inspection: prints the detected family, every geometry field, and every tensor name+shape.
+/// Returns true on a consistent file; sets `err` and returns false on refusal or mismatch.
+inline bool inspect_gguf(const std::string& path, std::string& err) {
+    const strata::GgufModel model = strata::GgufModel::open(path);
+    err = strata::check_architecture(model.meta());
+    if (!err.empty()) return false;
+    strata::core::ModelGeometry g;
+    int64_t top_k = 0;
+    if (!geometry_from_gguf(model.meta(), g, top_k, err)) return false;
+    size_t checked = 0;
+    if (!check_gguf_layout(model, g, err, &checked)) return false;
+    std::printf("family: %s (architecture '%s')\n", strata::model_family_title(g.family),
+                strata::model_family_arch(g.family));
+    if (g.family == strata::ModelFamily::DeepseekMoe) {
+        auto pi = [](const char* k, int64_t v) { std::printf("%s: %lld\n", k, (long long)v); };
+        auto pd = [](const char* k, double v) { std::printf("%s: %g\n", k, v); };
+        pi("deepseek.block_count", g.n_layers);
+        pi("deepseek.embedding_length", g.n_embd);
+        pi("deepseek.attention.head_count", g.n_head);
+        pi("deepseek.attention.head_count_kv", g.n_head_kv);
+        pi("deepseek.expert_count", g.n_expert);
+        pi("deepseek.expert_used_count", top_k);
+        pi("deepseek.expert_shared_count", g.n_expert_shared);
+        pi("deepseek.expert_feed_forward_length", g.n_ff);
+        pi("deepseek.feed_forward_length", g.n_ff_dense);
+        pi("deepseek.leading_dense_block_count", g.n_dense_first_blocks);
+        pd("deepseek.rope.freq_base", g.rope_freq_base);
+        pd("deepseek.attention.layer_norm_rms_epsilon", g.rms_eps);
+    } else {
+        std::printf("geometry: family-specific summary not implemented in --inspect\n");
+    }
+    size_t n_tensors = 0;
+    for (size_t s = 0; s < model.size(); ++s) n_tensors += model.shard(s).tensors().size();
+    std::printf("tensors: %zu\n", n_tensors);
+    for (size_t s = 0; s < model.size(); ++s)
+        for (const strata::TensorInfo& t : model.shard(s).tensors()) {
+            std::string shape;
+            for (uint64_t d : t.shape) shape += (shape.empty() ? "" : ", ") + std::to_string(d);
+            std::printf("%s [%s]\n", t.name.c_str(), shape.c_str());
+        }
+    return true;
+}
+
 }  // namespace strata::core
