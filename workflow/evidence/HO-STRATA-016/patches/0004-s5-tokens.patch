From 3c2f89555ad5723e4ecfa8e1995fc8921d93b556 Mon Sep 17 00:00:00 2001
From: KupipiKuki <masterkookus@gmail.com>
Date: Fri, 27 Nov 2026 18:32:03 -0500
Subject: [PATCH 2/2] HO-STRATA-016: block-0 input assertion vs direct
 token_embd row dequant (audit A14)

Every free-run position now checks b.residual (the block-0 input) against an
independent dequant of the fed token's row straight from the GGUF payload
(second GgufModel reader, same pattern as the dequant spot-check; not the
whole-table dequant the gather reads from). Bit-exactness required.

Read-only verification: no engine state is written, arithmetic unchanged.
Verified: P1 tokens identical to the pre-change run; 21 positions pass.

Limits: normal-run path only; teacher/inject diagnostic paths untouched.
---
 src/deepseek/ds_engine.cu | 52 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/src/deepseek/ds_engine.cu b/src/deepseek/ds_engine.cu
index ea1b122c7..6d578d1e5 100644
--- a/src/deepseek/ds_engine.cu
+++ b/src/deepseek/ds_engine.cu
@@ -896,11 +896,58 @@ int run(int argc, char** argv) {
             }
         }
 
+        // Block-0 input assertion (HO-STRATA-015 audit A14, carried into S5).  The
+        // residual every position feeds into block 0 is the embedding row of its
+        // token; here that row is re-dequantised INDEPENDENTLY from the GGUF's
+        // on-disk payload (a second reader — the same pattern as the dequant
+        // spot-check above, and not the whole-table dequant the gather reads from)
+        // and required to be bit-exact against b.residual.  Read-only: it never
+        // writes engine state, so the arithmetic and the dumps are unchanged.
+        strata::GgufModel em = strata::GgufModel::open(o.native);
+        size_t eshard = 0;
+        const strata::TensorInfo* et = em.find("token_embd.weight", &eshard);
+        if (!et) {
+            std::fprintf(stderr, "strata-deepseek: block-0 input assertion: token_embd.weight not found\n");
+            return 1;
+        }
+        const int etype = (int) et->type;
+        const size_t erow = K::iq_row_bytes(etype, N);
+        if (erow == 0) {
+            std::fprintf(stderr, "strata-deepseek: block-0 input assertion: no row geometry for token_embd type %d\n", etype);
+            return 1;
+        }
+        const uint8_t* eraw = em.shard(eshard).tensor_data(*et);
+        uint8_t* d_erow = nullptr;
+        float* d_eexp = nullptr;
+        CK(cudaMalloc(&d_erow, erow));
+        CK(cudaMalloc(&d_eexp, (size_t) N * 4));
+        std::vector<float> h_act((size_t) N), h_exp((size_t) N);
+        int block0_checked = 0;
+
         for (int pos = 0; pos < n_total; ++pos) {
             const int tok_id = (pos < n_prompt) ? (int) o.tokens[pos] : generated[pos - n_prompt];
             CK(cudaMemcpyAsync(b.residual, m.token_embd + (size_t) tok_id * N, N * 4,
                                cudaMemcpyDeviceToDevice, stream));
 
+            {
+                CK(cudaMemcpyAsync(d_erow, eraw + (size_t) tok_id * erow, erow, cudaMemcpyHostToDevice, stream));
+                D::dequant_to_f32(etype, d_erow, 0, 1, (int) N, d_eexp, stream);
+                CK(cudaMemcpyAsync(h_act.data(), b.residual, N * 4, cudaMemcpyDeviceToHost, stream));
+                CK(cudaMemcpyAsync(h_exp.data(), d_eexp, N * 4, cudaMemcpyDeviceToHost, stream));
+                CK(cudaStreamSynchronize(stream));
+                double maxd = 0.0;
+                for (int64_t i = 0; i < N; ++i) {
+                    const double d = std::fabs((double) h_act[i] - (double) h_exp[i]);
+                    if (d > maxd) maxd = d;
+                }
+                if (maxd != 0.0) {
+                    std::fprintf(stderr, "strata-deepseek: block-0 input assertion FAIL: pos %d tok %d, residual vs direct token_embd row: max abs diff %.6e\n",
+                                 pos, tok_id, maxd);
+                    return 1;
+                }
+                ++block0_checked;
+            }
+
             if (do_layer_dump) {
                 CK(cudaMemcpyAsync(b.dump + (size_t) pos * (n_layers + 1) * N, b.residual, N * 4,
                                    cudaMemcpyDeviceToDevice, stream));
@@ -937,6 +984,11 @@ int run(int argc, char** argv) {
             std::printf("logits_full layout: [step][vocab_index] f32, vocab_size=%lld\n", (long long) m.g.n_vocab);
         }
 
+        std::fprintf(stderr, "strata-deepseek: block-0 input assertion: %d positions, residual vs direct token_embd row dequant (type %d): max abs diff 0.000000e+00 ok\n",
+                     block0_checked, etype);
+        CK(cudaFree(d_erow));
+        CK(cudaFree(d_eexp));
+
         std::printf("gen:");
         for (int id : generated) std::printf(" %d", id);
         std::printf("\n");
