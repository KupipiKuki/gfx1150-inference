+}
+
+// Deterministic greedy: highest logit; ties -> lowest token id.
+static int argmax_lowest_id(const float* logits, int n) {
+    int best_id = 0;
+    float best = logits[0];
+    for (int i = 1; i < n; ++i) {
+        if (logits[i] > best) {
+            best = logits[i];
+            best_id = i;
+        }
+    }
+    return best_id;
+}
